<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/popupCardContainer"
    android:layout_width="175dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="22dp"
    app:cardElevation="0dp"
    app:cardMaxElevation="0dp"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="false"
    app:cardBackgroundColor="@android:color/transparent"
    app:strokeWidth="0dp">

    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurViewContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/popupInnerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/menuItemEdit"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:drawableStart="@drawable/baseline_edit_24"
                android:drawablePadding="14dp"
                android:text="@string/edit"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <TextView
                android:id="@+id/menuItemDelete"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:drawableStart="@drawable/baseline_delete_24"
                android:drawablePadding="14dp"
                android:text="@string/delete"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <TextView
                android:id="@+id/menuItemDeleteAll"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:drawableStart="@drawable/baseline_delete_forever_24"
                android:drawablePadding="14dp"
                android:text="@string/delete_all"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>
</com.google.android.material.card.MaterialCardView>
